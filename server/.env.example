# Copy to server/.env, then fill every active entry before starting the server.
# All example values are intentionally empty. Never commit server/.env.
OPENAI_API_KEY=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Required for OpenAI STT; optional when using only Qwen STT.
OPENAI_WHISPER_MODEL=

# Optional overrides: uncomment only after filling the value.
# LLM_MODE=
# LLM_MODEL=
# FREE_TALK_CHAT_MODEL=
# OPENAI_TTS_MODEL=
# OPENAI_TRANSLATE_MODEL=
# LOCAL_STT_QWEN_MODEL=
# LOCAL_STT_QWEN_DEVICE_MAP=
# LOCAL_STT_QWEN_DTYPE=
